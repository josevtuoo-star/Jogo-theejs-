[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogador"
3d_physics/layer_3="objetos_fisicos"
3d_physics/layer_4="zumbis"
3d_physics/layer_5="interagiveis"
3d_physics/layer_6="hitboxes"

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.47, 0.52, 1)

[ultimo_amanhecer]

input/force_touch_controls=false
